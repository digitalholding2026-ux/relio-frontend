{
  "name": "relio-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Application frontend Relio — socle technique minimal (Next.js + TypeScript)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:logique && npm run test:ui",
    "test:logique": "node --import tsx --test src/lib/*.test.ts",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verifier:poids": "node scripts/verifier-poids-css.mjs"
  },
  "dependencies": {
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.29"
  }
}
